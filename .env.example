# Blizzard API application credentials (required)
BLIZZARD_CLIENT_ID=replace_me
BLIZZARD_CLIENT_SECRET=replace_me

# Local Compose defaults. Use unique credentials in production and keep the
# password URL-encoded in DATABASE_URL if it contains reserved URL characters.
POSTGRES_USER=wowtools
POSTGRES_PASSWORD=replace_me
POSTGRES_DB=wowtools
DATABASE_URL=postgresql://wowtools:replace_me@localhost:5566/wowtools
APP_DATABASE_URL=postgresql://wowtools:replace_me@db:5432/wowtools

# Browser-visible backend URL baked into the frontend image.
NEXT_PUBLIC_API_URL=http://localhost:4111

# Sync/request tuning
BLIZZARD_REQUEST_TIMEOUT_MS=30000
BLIZZARD_MAX_RETRIES=4
REALM_SYNC_CONCURRENCY=4
ITEM_METADATA_BATCH_SIZE=250
REALM_HISTORY_INTERVAL_HOURS=6
PRICE_STALE_AFTER_MINUTES=55
PRICE_READINESS_MAX_AGE_MINUTES=90
RAW_SNAPSHOT_RETENTION_DAYS=14
DAILY_HISTORY_RETENTION_DAYS=365

# Host directory used by the one-shot backup profile.
BACKUP_DIR=./backups
