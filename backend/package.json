{
  "name": "backend",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "bun run src/index.ts",
    "test": "bun test",
    "test:integration": "bun run --no-env-file test/run-integration.ts",
    "test:setup": "bun run --no-env-file test/setup-database.ts",
    "dev:fixture": "bun run --no-env-file test/serve-local.ts",
    "migrate": "bun run src/scripts/migrate.ts",
    "typecheck": "tsc --noEmit",
    "reimport": "bun run src/scripts/reimport-game-data.ts",
    "generate-salvage-config": "bun run src/scripts/generate-salvaging-config.ts",
    "sync-prices": "bun run src/scripts/sync-prices.ts",
    "verify-history-archive": "bun run src/scripts/verify-history-archive.ts",
    "update-gear-reference": "bun run src/scripts/update-gear-reference.ts",
    "update-item-expansions": "bun run src/scripts/update-item-expansions.ts",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate": "bunx drizzle-kit migrate",
    "db:push": "bunx drizzle-kit push",
    "db:studio": "bunx drizzle-kit studio"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.19",
    "node-cron": "^4.6.0",
    "postgres": "^4.1.1"
  }
}
