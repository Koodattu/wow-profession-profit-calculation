{
  "name": "backend",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "reimport": "bun run src/scripts/reimport-game-data.ts",
    "generate-salvage-config": "bun run src/scripts/generate-salvaging-config.ts",
    "sync-prices": "bun run src/scripts/sync-prices.ts",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate": "bunx drizzle-kit migrate",
    "db:push": "bunx drizzle-kit push",
    "db:studio": "bunx drizzle-kit studio"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.1",
    "node-cron": "^4.6.0",
    "postgres": "^3.4.9"
  }
}
